{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/health.ts": {
      "maxDuration": 10
    },
    "api/config.ts": {
      "maxDuration": 10
    },
    "api/destinations.ts": {
      "maxDuration": 60
    },
    "api/generate-quests.ts": {
      "maxDuration": 60,
      "includeFiles": "src/lib/**"
    },
    "api/verify-guess.ts": {
      "maxDuration": 60,
      "includeFiles": "src/lib/**"
    },
    "api/me/profile.ts": {
      "maxDuration": 60
    },
    "api/me/trips.ts": {
      "maxDuration": 60
    },
    "api/me/trip.ts": {
      "maxDuration": 60
    },
    "api/me/photo.ts": {
      "maxDuration": 60
    },
    "api/photo.ts": {
      "maxDuration": 30
    }
  }
}
